# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Backend
DATABASE_URL=postgresql://porygon:porygon@localhost:5432/porygon_db
MQTT_HOST=localhost
MQTT_PORT=1883
SECRET_KEY=your-secret-key-here

# Digital Twin
NEXT_PUBLIC_MAIN_APP_URL=http://localhost:3000

# Generative AI for custom industry templates (optional).
# When OPENAI_API_KEY is set the /api/industries/generate route uses OpenAI;
# otherwise it falls back to a deterministic on-device generator with no
# external requests.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
