# Public URLs (set these to your real domains in production)
SIM_URL=http://localhost:3000
TWIN_URL=http://localhost:3001
API_URL=http://localhost:8000
WS_URL=ws://localhost:8000

# Internal upstream the digital-twin's server-side proxy forwards to.
# In docker-compose this defaults to the "frontend" service hostname,
# so the two containers talk over the docker network privately.
# Override only if you run the digital-twin outside docker-compose.
MAIN_APP_URL=http://frontend:3000

# Frontend (also used by digital-twin)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MAIN_APP_URL=http://localhost:3000

# Backend
DATABASE_URL=postgresql://porygon:porygon@postgres:5432/porygon_db
MQTT_HOST=emqx
MQTT_PORT=1883
SECRET_KEY=change-me-in-prod-32-chars-minimum

# OpenAI (optional — used by /api/industries/generate)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
